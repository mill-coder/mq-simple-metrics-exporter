FROM alpine:3.21
RUN apk add --no-cache mksh grep coreutils
RUN ln -sf /bin/mksh /bin/ksh
COPY tests/mock-bin/ /usr/local/bin/
COPY tests/fixtures/ /opt/fixtures/
COPY mq-metrics.ksh /opt/mq-metrics.ksh
RUN chmod +x /usr/local/bin/* /opt/mq-metrics.ksh
ENV PATH="/usr/local/bin:${PATH}"
WORKDIR /opt
ENTRYPOINT ["/bin/ksh"]
