FROM alpine:3.21
RUN apk add --no-cache python3 grep coreutils mksh \
    && ln -sf /bin/mksh /bin/ksh
COPY tests/mock-bin/ /usr/local/bin/
COPY tests/fixtures/ /opt/fixtures/
COPY mq-metrics.py /opt/mq-metrics.py
RUN chmod +x /usr/local/bin/* /opt/mq-metrics.py
ENV PATH="/usr/local/bin:${PATH}"
WORKDIR /opt
ENTRYPOINT ["python3"]
