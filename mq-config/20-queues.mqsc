* Custom queue definitions for mq-metrics testing
* These are created in addition to the default DEV.QUEUE.1-3

DEFINE QLOCAL('APP.ORDERS.IN')       DEFPSIST(YES) MAXDEPTH(10000) REPLACE
DEFINE QLOCAL('APP.ORDERS.OUT')      DEFPSIST(YES) MAXDEPTH(10000) REPLACE
DEFINE QLOCAL('APP.ORDERS.DLQ')      DEFPSIST(YES) MAXDEPTH(50000) REPLACE

DEFINE QLOCAL('APP.PAYMENTS.IN')     DEFPSIST(YES) MAXDEPTH(10000) REPLACE
DEFINE QLOCAL('APP.PAYMENTS.OUT')    DEFPSIST(YES) MAXDEPTH(10000) REPLACE
DEFINE QLOCAL('APP.PAYMENTS.DLQ')    DEFPSIST(YES) MAXDEPTH(50000) REPLACE

DEFINE QLOCAL('APP.NOTIFY.EVENTS')   DEFPSIST(NO)  MAXDEPTH(20000) REPLACE
DEFINE QLOCAL('APP.NOTIFY.ALERTS')   DEFPSIST(NO)  MAXDEPTH(20000) REPLACE

DEFINE QLOCAL('APP.AUDIT.LOG')       DEFPSIST(YES) MAXDEPTH(100000) REPLACE
DEFINE QLOCAL('APP.BATCH.REQUESTS')  DEFPSIST(YES) MAXDEPTH(5000)  REPLACE
